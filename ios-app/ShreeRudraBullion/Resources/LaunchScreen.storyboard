<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="Lch-01-VC">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Launch Screen: same first frame as SplashView (Om background, logo animates in afterwards)-->
        <scene sceneID="Lch-01-SCN">
            <objects>
                <viewController id="Lch-01-VC" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Lch-01-VIW">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="SplashBackground" translatesAutoresizingMaskIntoConstraints="NO" id="Lch-01-IMG">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                            </imageView>
                            <view userInteractionEnabled="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="Lch-01-OVR">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                                <color key="backgroundColor" red="0.067" green="0.075" blue="0.094" alpha="0.18" colorSpace="custom" customColorSpace="sRGB"/>
                                <viewLayoutGuide key="safeArea" id="Lch-01-OSA"/>
                            </view>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Lch-01-SAF"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="Lch-01-IMG" firstAttribute="top" secondItem="Lch-01-VIW" secondAttribute="top" id="Lch-01-C01"/>
                            <constraint firstItem="Lch-01-IMG" firstAttribute="bottom" secondItem="Lch-01-VIW" secondAttribute="bottom" id="Lch-01-C02"/>
                            <constraint firstItem="Lch-01-IMG" firstAttribute="leading" secondItem="Lch-01-VIW" secondAttribute="leading" id="Lch-01-C03"/>
                            <constraint firstItem="Lch-01-IMG" firstAttribute="trailing" secondItem="Lch-01-VIW" secondAttribute="trailing" id="Lch-01-C04"/>
                            <constraint firstItem="Lch-01-OVR" firstAttribute="top" secondItem="Lch-01-VIW" secondAttribute="top" id="Lch-01-C05"/>
                            <constraint firstItem="Lch-01-OVR" firstAttribute="bottom" secondItem="Lch-01-VIW" secondAttribute="bottom" id="Lch-01-C06"/>
                            <constraint firstItem="Lch-01-OVR" firstAttribute="leading" secondItem="Lch-01-VIW" secondAttribute="leading" id="Lch-01-C07"/>
                            <constraint firstItem="Lch-01-OVR" firstAttribute="trailing" secondItem="Lch-01-VIW" secondAttribute="trailing" id="Lch-01-C08"/>
